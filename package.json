{
  "name": "tce-main-street",
  "version": "0.1.22",
  "private": true,
  "description": "Single-game Tableau Card Engine launcher for \"main-street\". Composes the engine checkout at ./core and builds web + Electron renderer bundles.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run engine:sync && tsc --noEmit && vite build",
    "build:electron": "npm run engine:sync && tsc --noEmit && vite build --mode electron",
    "build:release": "npm run engine:verify && tsc --noEmit && vite build",
    "engine:sync": "node ./core/scripts/engine-sync.mjs sync",
    "engine:verify": "node ./core/scripts/engine-sync.mjs verify",
    "engine:check": "tsx tests/tooling/engine-checkout-precheck.ts",
    "preview": "vite preview --host",
    "balance-cards": "tsx src/scripts/run-balance-cards.ts",
    "validate:storylines": "vite-node src/scripts/validate-storylines-cli.ts",
    "storylines:graph": "vite-node src/scripts/storyline-graph-cli.ts",
    "storylines:graph:svg": "vite-node src/scripts/render-storyline-graph-cli.ts",
    "docs:diagrams": "vite-node src/scripts/card-diagrams-cli.ts",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "storylines:author": "vite-node src/scripts/storyline-author-cli.ts",
    "pretest": "tsx src/scripts/check-playwright-chromium.ts",
    "test": "tsx scripts/run-tests.ts --timeout-ms 720000 --project unit --project unit-cli",
    "test:browser": "vitest run --project browser tests/main-street/cards/browser",
    "test:smoke": "bash scripts/run-smoke-tests.sh",
    "test:dev": "bash scripts/run-dev-tests.sh",
    "context:check": "bash scripts/refresh-context-thresholds.sh --check",
    "context:refresh": "bash scripts/refresh-context-thresholds.sh",
    "monte-carlo": "vite-node src/scripts/monte-carlo.ts --seeds 200 --seed-prefix mc-balance --maxTurns 25 --strategy greedy --out results/main-street-monte-carlo.json --csv-out results/main-street-monte-carlo.csv",
    "monte-carlo-sweep": "vite-node src/scripts/monte-carlo.ts --sweep --seeds 100 --seed-prefix mc-balance --maxTurns 25 --out results/sweep.json --csv-out results/sweep.csv",
    "replay": "tsx scripts/replay.ts",
    "scaffold:game": "tsx scripts/game-repo-scaffold.ts",
    "scaffold:games": "tsx scripts/game-repo-scaffold.ts --all --core-root . --repos-dir ..",
    "transcripts:export": "tsx scripts/export-transcripts.ts",
    "save-load-smoke": "vite-node src/scripts/save-load-smoke.ts",
    "tf:generate": "scripts/tf-generate-synths.sh",
    "build:card-pack": "npm run generate:pack-assets && tsx ./core/scripts/build-card-pack.mjs --input packs",
    "generate:pack-assets": "node src/scripts/generate-residential-pack-art.mjs",
    "build:electron-main": "node scripts/build-electron-main.mjs",
    "start:electron": "npm run build:electron && npm run build:electron-main && electron .",
    "package": "npm run build:electron && npm run build:electron-main && electron-builder --publish never",
    "package:win": "npm run build:electron && npm run build:electron-main && electron-builder --win --publish never",
    "package:linux": "npm run build:electron && npm run build:electron-main && electron-builder --linux --publish never",
    "package:mac": "npm run build:electron && npm run build:electron-main && electron-builder --mac --publish never",
    "balance:drift-report": "vite-node src/scripts/balance/drift-report.ts",
    "balance:synergy-diversity-report": "vite-node src/scripts/balance/synergy-diversity-report.ts",
    "test:unit": "tsx scripts/run-tests.ts --timeout-ms 720000 --project unit --project unit-cli",
    "scaffold": "tsx ./core/scripts/game-repo-scaffold.ts --game main-street --game-repo-root . --core-root ./core"
  },
  "dependencies": {
    "phaser": "4.0.0-rc.7",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/browser": "^3.2.4",
    "ajv": "^8.12.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "mermaid": "11.4.1",
    "playwright": "^1.58.2",
    "prettier": "^3.8.3",
    "sharp": "^0.33.0",
    "tone": "^15.1.22",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
