        "tests/e2e/main-street-tutorial-e2e-part4.browser.test.ts",
        "tests/e2e/main-street-tutorial-e2e-part5.browser.test.ts",
        "tests/e2e/main-street-tutorial-e2e-part6.browser.test.ts",
        "tests/main-street/TutorialOverlayHighlights.browser.test.ts",
        "tests/main-street/TutorialOverlayManager.browser.test.ts"
      ]
    },
    "main-street-hud-count": {
      "commands": [
        "npx vitest run --project browser tests/main-street/hud-total-counting-live.browser.test.ts"
      ],
      "paths": [
