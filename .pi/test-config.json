        "tests/main-street/hint-bar-placement.browser.test.ts",
        "tests/main-street/composite-click.browser.test.ts",
        "tests/main-street/upgrade-hand-flow.browser.test.ts",
        "tests/main-street/event-card-select-then-act.browser.test.ts",
        "tests/main-street/discard-from-hand.browser.test.ts",
